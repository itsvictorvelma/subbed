# Caddy in front of Subbed (specs 020, 030): gets and renews the HTTPS certificate for
# SUBBED_DOMAIN, redirects HTTP to HTTPS and www to the bare domain, and passes every request
# to the app on the private network with the visitor's real IP.
{
	servers {
		# Cloudflare's proxy addresses (https://www.cloudflare.com/ips-v4 and /ips-v6, copied
		# 2026-11-23). Only a request from these may name the visitor in CF-Connecting-IP; anyone
		# else is taken at their own address. Refresh the list if Cloudflare changes it.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.{$SUBBED_DOMAIN} {
	redir https://{$SUBBED_DOMAIN}{uri} permanent
}

{$SUBBED_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy subbed:8000 {
		# One value, the resolved visitor IP. Appending (the default) would leave a Cloudflare
		# address last, and the app would count that address as the guest.
		header_up X-Forwarded-For {client_ip}
	}
}
